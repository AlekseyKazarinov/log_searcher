<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="pane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="488.0" prefWidth="1040.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sample.Controller">
   <children>
      <HBox layoutX="14.0" layoutY="14.0" spacing="20.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label fx:id="label4" prefHeight="17.0" prefWidth="217.0" text="Найденные файлы:" />
                  <FlowPane fx:id="flowPane" prefHeight="425.0" prefWidth="217.0">
                     <children>
                        <TreeView fx:id="treeFiles" onMouseClicked="#loadFileMouseClicked" prefHeight="437.0" prefWidth="220.0">
                           <contextMenu>
                              <ContextMenu fx:id="loadContextMenu" onAction="#loadSelectedItem">
                                <items>
                                  <MenuItem mnemonicParsing="false" text="Открыть" />
                                </items>
                              </ContextMenu>
                           </contextMenu>
                        </TreeView>
                     </children>
                  </FlowPane>
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label fx:id="label1" text="Выберите каталог для поиска:" />
