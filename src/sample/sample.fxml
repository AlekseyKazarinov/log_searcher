                     <children>
                        <Button fx:id="buttonSelectDir" mnemonicParsing="false" onAction="#clickSelectDir" text="Выбрать..." />
                        <TextArea fx:id="selectedDirArea" maxHeight="-Infinity" prefHeight="15.0" prefWidth="249.0" />
                     </children>
                  </HBox>
                  <Label fx:id="label2" lineSpacing="10.0" text="Введите текст, который хотите найти:" />
                  <TextArea fx:id="textToSearchArea" prefHeight="200.0" prefWidth="331.0" />
